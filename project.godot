; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Faver Mass v1"
config/description="Sucesor en Godot 4 de FaverMass — FPS de supervivencia por oleadas."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameData="*res://scripts/core/game_data.gd"
GameState="*res://scripts/core/game_state.gd"
FxManager="*res://scripts/core/fx_manager.gd"
Config="*res://scripts/core/config.gd"
ModManager="*res://scripts/core/mod_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

; Por defecto Godot corre hasta 8 pasos de física en un frame para "ponerse al
; día" cuando el frame tardó mucho. Con muchos enemigos eso es una espiral: el
; frame tarda, se corren 8 pasos de física, tarda más todavía. Con 2, si el
; juego no llega, el mundo va un poco más lento en vez de congelarse.
common/max_physics_steps_per_frame=2

[rendering]

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=1
anti_aliasing/quality/msaa_3d=1
environment/subsurface_scattering/subsurface_scattering_quality=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/atlas_size=2048
